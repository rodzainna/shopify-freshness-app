{
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "target": "ES2024",
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true
  }
}
