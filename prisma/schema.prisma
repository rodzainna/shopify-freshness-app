// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ProcessedWebhook {
  id          String   @id
  topic       String
  processedAt DateTime @default(now())
}

// Serializes batch updates per product; expiresAt frees a crashed holder's lock.
model ProductLock {
  shop      String
  productId String
  token     String
  expiresAt DateTime

  @@id([shop, productId])
}

enum DiscrepancyReason {
  oversell
  expired_stock_only
  product_not_found
  too_many_batches
  changed_during_retry
}

// A fulfillment's target batch state for one product, saved before any Shopify
// write so a retry re-applies it instead of decrementing again.
model FulfillmentPlan {
  shop          String
  fulfillmentId String
  productId     String
  plan          Json
  createdAt     DateTime  @default(now())
  appliedAt     DateTime?

  @@id([shop, fulfillmentId, productId])
  @@index([shop, productId, appliedAt])
}

// Units a fulfillment couldn't take from fresh stock, or a product it couldn't process.
model FulfillmentDiscrepancy {
  shop          String
  fulfillmentId String
  productId     String
  reason        DiscrepancyReason
  shortfall     Int?
  expiredUnits  Int?
  createdAt     DateTime          @default(now())

  // One row per reason: a shortfall and a later retry conflict can both apply
  @@id([shop, fulfillmentId, productId, reason])
  @@index([shop, createdAt])
}
